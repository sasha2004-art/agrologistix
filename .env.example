# Application
APP_ENV=development

# Access control
USER_ACCESS_PIN=202601
ADMIN_ACCESS_PIN=999999

# Persistence
SQLITE_DB_PATH=./data/app.db

# External services
# Погода: короткий таймаут, чтобы недоступный Open-Meteo не тормозил ответ.
EXTERNAL_API_TIMEOUT_SEC=1.5
# Mapbox Directions: матрица строится по одному запросу на пару точек, поэтому
# с коротким таймаутом расчёт уходил в haversine-фолбэк (прямые линии).
MAPBOX_TIMEOUT_SEC=8
SOLVER_TIME_LIMIT_SEC=1.0
WEATHER_LATITUDE=55.11
WEATHER_LONGITUDE=36.61
WEATHER_CACHE_TTL_SEC=900
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://localhost:4173
# Server-side Mapbox token (Matrix/Directions), never exposed to the browser
MAPBOX_SECRET_TOKEN=
# Public Mapbox token for the map: build-time variable, inline into the JS bundle.
# In CI set it as the Repository Variable VITE_MAPBOX_PUBLIC_TOKEN (see docs/LAUNCH.md).
VITE_MAPBOX_PUBLIC_TOKEN=
VITE_API_BASE_URL=/api/v1
# Dev-only mock fallback (frontend) when the local API is unreachable
VITE_DEMO_USER_PIN=202601
VITE_DEMO_ADMIN_PIN=999999
